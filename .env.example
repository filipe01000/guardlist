# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL (Object Method — Runtime App User & Admin Migration User)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="postgres"
SQL_USER="ai_studio_app"
SQL_PASSWORD="REDACTED"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="REDACTED"

# Render + Neon: use a direct Neon URL; never commit the real value.
DATABASE_URL=
NODE_ENV=production

# WebAuthn Relying Party. On Render, RENDER_EXTERNAL_URL is used when these are empty.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Client IP (rate limits, blocking, audit). Forwarded headers only count when a trusted proxy wrote them.
# CLIENT_IP_HEADER: header set by the edge, e.g. cf-connecting-ip. On Render it defaults to
# cf-connecting-ip (Cloudflare sits in front and rewrites it). Use "none" to turn it off.
CLIENT_IP_HEADER=
# TRUST_PROXY: "loopback" (default, proxy on the same machine), a hop count such as 1, or "none".
TRUST_PROXY=
