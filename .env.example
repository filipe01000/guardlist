# Copie para .env (que fica fora do Git) e preencha. Nunca versione valores reais.

# Banco: URL do Postgres. No Render, a URL direta do Neon, guardada como segredo.
DATABASE_URL=
# Alternativa ao DATABASE_URL (usada nos testes): SQL_HOST, PGPORT, SQL_USER, SQL_PASSWORD, SQL_DB_NAME.

NODE_ENV=production
PORT=3000

# WebAuthn (passkeys). No Render, o RENDER_EXTERNAL_URL é usado quando estes ficam vazios.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# IP do cliente (limites, bloqueios e auditoria). Cabeçalhos de IP só valem vindos de proxy confiável.
# CLIENT_IP_HEADER: cabeçalho posto pela borda, por exemplo cf-connecting-ip. No Render já vem ligado
# em cf-connecting-ip, porque a Cloudflare fica na frente e reescreve esse cabeçalho. Use "none" para
# desligar.
CLIENT_IP_HEADER=
# TRUST_PROXY: "loopback" (padrão, proxy na própria máquina), um número de saltos (ex.: 1) ou "none".
TRUST_PROXY=
