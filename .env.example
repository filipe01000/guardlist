# Copie este arquivo para .env.local e preencha apenas no seu computador.
# Nunca envie .env.local ao Git ou coloque estas chaves em variáveis VITE_*.
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=

# Banco Postgres da equipe (Neon). Sem ele, o servidor usa um banco local em .data/ (só para testes).
DATABASE_URL=

# Primeiros usuários: só são lidos quando o banco ainda não tem nenhum usuário.
# APP_USERS: linhas geradas com `npm run user:add -- <usuario>`, separadas por vírgula (viram administradores).
# ADMIN_INITIAL_PASSWORD: cria o usuário "admin" com esta senha provisória (mínimo 10 caracteres).
APP_USERS=
ADMIN_INITIAL_PASSWORD=
# Segredo que assina as sessões. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Duração da sessão em horas.
SESSION_TTL_HOURS=12

# Limite de consultas por IP de origem, por minuto.
CTI_RATE_LIMIT_PER_MIN=30
ABUSE_SUMMARY_RATE_LIMIT_PER_MIN=120

# A prévia local escuta apenas no próprio computador por padrão.
PORT=3000
HOST=127.0.0.1

# Bloqueio da conta após senhas erradas seguidas.
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# E-mail (relatório mensal no dia 1º e backup diário). Funciona com qualquer SMTP:
# Gmail (smtp.gmail.com, porta 465, senha de app), Outlook (smtp.office365.com, 587), Brevo, Resend, SES...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GuardList <guardlist@suaempresa.com.br>"
# Destinatários separados por vírgula. BACKUP_EMAILS vazio usa REPORT_EMAILS.
REPORT_EMAILS=
BACKUP_EMAILS=
# Horário (Brasília) a partir do qual cada rotina roda.
BACKUP_HOUR=3
REPORT_HOUR=8
# Endereço público do app (logo e links nos e-mails). No Render, RENDER_EXTERNAL_URL já é usado.
PUBLIC_URL=

# Reputação em lote (importação e gráficos): validade do cache e limite de chamadas por minuto.
CTI_CACHE_HOURS=72
CTI_ENRICH_RATE_LIMIT_PER_MIN=20
